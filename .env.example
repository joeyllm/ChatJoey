# Server-only JoeyLLM configuration. Never prefix these with NEXT_PUBLIC_.
JOEYLLM_API_URL=https://api.joeyllm.ai
JOEYLLM_API_KEY=

# Optional. When omitted, the app selects the first model returned by /v1/models.
JOEYLLM_MODEL=

# Optional local-only preview. Production deployments never fall back to mock mode.
JOEYLLM_MOCK_MODE=false

# Optional. Which Joey Mode to render — see modes/. Defaults to "baby-joey".
NEXT_PUBLIC_JOEY_MODE=
