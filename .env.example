# Server-only configuration. Never prefix these with NEXT_PUBLIC_.

# JoeyBackend base URL. It owns /chat, the persona, modes, model and
# generation settings. ChatJoey just forwards { messages, mode }.
JOEYBACKEND_URL=https://api.joeyllm.ai

# Bearer key for JoeyBackend's /chat. Server-side only — sent as
# `Authorization: Bearer` from app/api/chat/route.ts, never to the browser.
# Currently the same value as the internal vLLM key (k8s Secret joeybackend/
# joey-vllm).
JOEYLLM_API_KEY=

# Optional local-only preview. Production never falls back to mock mode.
JOEYBACKEND_MOCK_MODE=false

# Optional. Which Joey Mode to render — see modes/. Defaults to "little-joey".
NEXT_PUBLIC_JOEY_MODE=
